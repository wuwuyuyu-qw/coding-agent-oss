# ==========================================
# 1. 环境变量与敏感密钥 (最重要，绝对不能提交)
# ==========================================
.env
.env.*
*.pem
*.key

# ==========================================
# 2. Python 缓存与编译文件
# ==========================================
__pycache__/
*.py[cod]
*$py.class
*.so

# ==========================================
# 3. 虚拟环境 (体积过大，不要提交)
# ==========================================
venv/
.venv/
env/
Pipfile.lock
poetry.lock

# ==========================================
# 4. IDE 与编辑器配置 (避免团队成员配置冲突)
# ==========================================
.vscode/
.idea/
.DS_Store

# Private notes (never publish)
AGENTS_INTERVIEW_CARDS.md

# ==========================================
# 5. Agent 运行时临时文件与评估日志
# ==========================================
# Agent 执行测试代码时的沙盒或临时目录
tmp/
temp_workspace/
workspace/

# 运行日志
*.log
logs/
!examples/error.log

# 自动化评估端到端跑出来的基准测试结果 (避免大量冗余数据)
eval_results/
benchmark_outputs/
benchmark/results/
*.jsonl

# ==========================================
# 6. 测试 & 覆盖率产物（本地跑完应 gitignore）
# ==========================================
.pytest_cache/
.coverage
.coverage.*
coverage.xml
htmlcov/
.tox/
.nox/
.mypy_cache/
.ruff_cache/

# ==========================================
# 7. 构建产物
# ==========================================
build/
dist/
*.egg-info/
*.egg
